# Mapa de Registos
# val: $t0
# n  : $t1
# min: $t2
# max: $t3

	.eqv	print_string, 4
	.eqv	print_int10, 1
	.eqv	read_int10, 5
	.eqv	print_int16, 34

	.data
str1:	.asciiz "Digite ate 20 inteiros (zero para terminar): "
str2:	.asciiz "Maximo/minimo sao: "
str3:	.asciiz ":"

	.text
	.globl main
	
main:
	li	$t0, 0			# val = 0
	li	$t1, 0			# n = 0
	li	$t2, 0x7FFFFFFF		# min = 0x7FFFFFFF
	li	$t3, 0x80000000		# max = 0x80000000
					
	la	$a0, str1		
	li	$v0, print_string	#print_string("Digite ate 20 inteiros (zero para terminar): ")
	syscall
	
do_while:
	
	li	$v0, read_int10
	syscall
	move	$t0, $v0
	
	beq	$t0, $0, skip_value
	
	ble	$t0, $t3, skip_max
	move	$t3, $t0
	
skip_max:
	bge	$t0, $t2, skip_min
	move	$t2, $t0
	
skip_min:
	
skip_value:
	addi	$t1, $t1, 1
	
	bge	$t1, 20, end_while
	beq	$t0, $0, end_while
	j	do_while
	
end_while:
	la	$a0, str2
	li	$v0, print_string
	syscall
	
	move	$a0, $t3
	li	$v0, print_int10
	syscall
	
	la	$a0, str3
	li	$v0, print_string
	syscall
	
	move	$a0, $t2
	li	$v0, print_int10
	syscall
	
	jr	$ra