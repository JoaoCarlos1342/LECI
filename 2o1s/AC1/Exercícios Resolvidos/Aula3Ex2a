# Mapa de Registos
# value: $t0
# bit:	 $t1
# i:	 $t2

	.eqv	SIZE, 32
	.eqv	print_int10, 1
	.eqv	read_int, 5
	.eqv	print_string, 4
	.eqv	print_char, 1

	.data
str1:	.asciiz "Introduza um numero: "
str2:	.asciiz "\nO valor em binário e: "
char0:	.asciiz	"0"
char1:	.asciiz	"1"

	.text
	.globl main
	
main:
	la	$a0, str1
	li	$v0, print_string
	syscall
	
	li	$v0, read_int
	syscall
	move	$t0, $v0
	
	la	$a0, str2
	li	$v0, print_string
	syscall
	
	li	$t2, 0
	li	$t3, 0x80000000
	
for:
	bge	$t2, SIZE, end_for
	and	$t1, $t0, $t3
	beq	$t1, $0, else
	
	la	$a0, char1
	li	$v0, print_string
	syscall
	
	sll	$t0, $t0, 1
	addi	$t2, $t2, 1
	j	for
	
else:
	la	$a0, char0
	li	$v0, print_string
	syscall
	sll	$t0, $t0, 1
	addi	$t2, $t2, 1
	j	for
	
end_for:
	jr	$ra
